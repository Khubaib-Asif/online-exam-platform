{
  "name": "online-exam-platform-root",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "code/frontend",
    "code/backend"
  ],
  "scripts": {
    "lint": "npm run lint --workspace=code/frontend",
    "typecheck": "npm run typecheck --workspace=code/frontend",
    "test:unit": "echo 'No isolated unit tests yet, skipping...' && exit 0",
    "test:integration": "npx vitest run code/frontend/integration-tests",
    "build": "npm run build --workspace=code/frontend && npm run build --workspace=code/backend"
  },
  "dependencies": {
    "ts-api-utils": "2.0.1"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
